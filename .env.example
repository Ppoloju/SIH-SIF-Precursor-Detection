# ============================================================
# SIH SIF Precursor Detection — Environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Backend ---
# Groq API key for the optional LLM (Llama) assistance layer.
# If missing/empty, the backend degrades gracefully to rule-based analysis.
GROQ_API_KEY=

# Database. The SAME code path runs against either backend:
#
# OPTION 1 — PostgreSQL (recommended for the real flow).
#   Local:  docker compose up -d   (see docker-compose.yml)
#   Remote: Supabase PostgreSQL connection string goes here.
DATABASE_URL=postgresql+psycopg://sif:sif@localhost:5432/sif_detection
#
# OPTION 2 — Local SQLite file (zero-setup demo; comment the line above out):
# DATABASE_URL=sqlite:///./sif_detection.db

# PostgreSQL driver + XLSX support (install once in the venv):
#   pip install "psycopg[binary]" openpyxl

# Supabase project URL / anon key are only needed if you use the Supabase
# JS/data API instead of the DATABASE_URL connection string.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Frontend ---
# Base URL of the FastAPI backend (used by the Next.js client).
NEXT_PUBLIC_API_URL=http://localhost:8000
